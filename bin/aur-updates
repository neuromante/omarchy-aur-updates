#!/usr/bin/env python3
"""Report installed AUR (foreign) packages that have an update available.

Runs `yay -Qua` and emits a single JSON object on stdout:

    {"count": N, "packages": [{"name", "current", "latest"}],
     "error": "", "checked": <epoch seconds>}

`yay -Qua` queries the AUR RPC for the installed foreign packages, so it does
not need a root-owned sync nor a prior `-Sy`. Everything the widget draws comes
from this JSON; the QML side never parses yay output itself.
"""

import json
import re
import shutil
import subprocess
import sys
import time

TIMEOUT_SECONDS = 120
PACKAGE_LINE = re.compile(r"^(\S+)\s+(\S+)\s+->\s+(\S+)(?:\s+\[ignored\])?$")


def emit(result):
    print(json.dumps(result))
    sys.exit(0)


def parse_line(line):
    """Parse one `yay -Qua` line, or return None for unrecognized output."""
    match = PACKAGE_LINE.fullmatch(line.strip())
    if not match:
        return None
    return {
        "name": match.group(1),
        "current": match.group(2),
        "latest": match.group(3),
    }


def read_result(proc, result):
    """Parse yay output while distinguishing an empty result from failures."""
    packages = []
    unrecognized = []
    for line in proc.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        package = parse_line(line)
        if package is None:
            unrecognized.append(line)
        else:
            packages.append(package)

    stderr = (proc.stderr or "").strip().splitlines()
    if unrecognized:
        result["error"] = "Output yay non riconosciuto: " + unrecognized[-1]
    elif proc.returncode != 0 and (packages or stderr):
        result["error"] = stderr[-1] if stderr else f"yay è terminato con codice {proc.returncode}"
    elif not packages and stderr:
        result["error"] = stderr[-1]
    elif proc.returncode not in (0, 1):
        result["error"] = f"yay è terminato con codice {proc.returncode}"

    result["packages"] = packages
    result["count"] = len(packages)
    return result


def main():
    result = {"count": 0, "packages": [], "error": "", "checked": int(time.time())}

    if not shutil.which("yay"):
        result["error"] = "yay non trovato"
        emit(result)

    try:
        proc = subprocess.run(
            ["yay", "-Qua", "--color", "never"],
            capture_output=True,
            text=True,
            timeout=TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        result["error"] = "Timeout nella query AUR"
        emit(result)
    except Exception as exc:  # noqa: BLE001 - surface any failure in the UI
        result["error"] = str(exc)
        emit(result)

    # `yay -Qua` uses status 1 when there is simply nothing to report. Other
    # non-zero statuses, malformed output, or stderr are surfaced as errors.
    read_result(proc, result)
    emit(result)


if __name__ == "__main__":
    main()
